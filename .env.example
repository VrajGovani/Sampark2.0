# ========================================================
# Sampark 2.0 Environment Configuration
# ========================================================

# 1. DATABASE CONFIGURATION
# By default, Sampark uses SQLite (stored in ./sampark.db).
# To use Supabase PostgreSQL, paste your Connection String below:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. APPLICATION SECURITY
SECRET_KEY=sampark-super-secure-secret-key-change-in-production-2026

